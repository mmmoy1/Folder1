rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Products: readable by all, writable by authenticated admins
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Marketplace listings: readable by all, writable by server
    match /marketplace_listings/{listingId} {
      allow read: if true;
      allow write: if true;
    }

    // Pipeline jobs: readable by all, writable by server
    match /pipeline_jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
